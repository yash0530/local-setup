alias agy="agy --dangerously-skip-permissions"

# Claude dispatcher. A function, not an alias, because it takes subcommands.
# `command claude` bypasses it, so it does not recurse.
#   claude                                    Pro subscription (default)
#   claude open_router [ox_alpha|<model>]     OpenRouter (defaults to stealth/ox-alpha)
#   claude local qwen38_27 [--bits 4|5|6|8] [--think xhigh|medium|low]
#                                             Qwen 3.8 27B (default bits 5, think xhigh;
#                                             --bits 4 runs on LM Studio's Splash engine)
#   claude local [--think xhigh|medium|low]   whatever model is already resident
#   claude subagent                           Pro + the opt-in local delegation subagent
# Every branch forwards "$@", so flags survive: `claude -p "..."`,
# `claude local qwen38_27 --resume`, and so on.
claude() {
  case "${1:-}" in
    open_router|openrouter)
      shift
      case "${1:-}" in
        ox_alpha|ox-alpha|ox|oxalpha)
          shift
          openrouter-code --model "stealth/ox-alpha" "$@"
          ;;
        -*|"")
          openrouter-code --model "stealth/ox-alpha" "$@"
          ;;
        *)
          local _m="$1"
          shift
          openrouter-code --model "$_m" "$@"
          ;;
      esac
      ;;
    local)
      shift
      case "${1:-}" in
        qwen38_27|qwen38_27b)
          # --bits 4 = LM Studio Splash; 5/6/8 = llama.cpp GGUF. qwen-code normalises
          # --think and restarts only the proxy if a running stack is at another level.
          shift
          local _bits=5 _think=xhigh
          while true; do
            case "${1:-}" in
              --bits)   _bits="${2:-5}"; shift 2 ;;
              --think)  _think="${2:-xhigh}"; shift 2 ;;
              *) break ;;
            esac
          done
          local _m
          case "$_bits" in
            8) _m=gguf8 ;;
            6) _m=gguf6 ;;
            5) _m=gguf5 ;;
            4)
              if ! command -v lms >/dev/null 2>&1 && [[ ! -x "$HOME/.lmstudio/bin/lms" ]]; then
                echo "claude local qwen38_27: --bits 4 runs on LM Studio's Splash engine, which is not installed" >&2
                echo "  install LM Studio (see README §5.0), or use --bits 5|6|8" >&2
                return 1
              fi
              _m=splash4
              ;;
            *) echo "claude local qwen38_27: --bits must be 4, 5, 6 or 8" >&2; return 1 ;;
          esac
          qwen-code --model "$_m" --think "$_think" "$@"
          ;;
        # Fail loudly on an unknown word: forwarding it would make it the session's
        # first prompt.
        --think)   qwen-code --think "${2:-xhigh}" "${@:3}" ;;
        -*|"")     qwen-code --think xhigh "$@" ;;
        *)
          echo "claude local: unknown model '$1'" >&2
          echo "  expected: qwen38_27 [--bits 4|5|6|8] [--think xhigh|medium|low]" >&2
          echo "  (if this name looks right, run: source ~/.zshrc)" >&2
          return 1
          ;;
      esac
      ;;
    subagent) shift; claude-local-subagent "$@" ;;
    *)        command claude --dangerously-skip-permissions "$@" ;;
  esac
}

# Claude Code Auto-Resume Daemon
alias claude_resume="claude-resume"
alias claude_resume_logs="claude-resume logs"

# ------------------------------------------------------------------------------
# Local LLM stack (Qwen 3.8 27B via llama-server GGUF or LM Studio Splash)
# ------------------------------------------------------------------------------
# ANTHROPIC_BASE_URL is deliberately NOT exported here: it would route plain `claude`
# to the local model. It is scoped inside qwen-code only.

alias llm_start="llm-serve start"          # defaults to gguf5
alias llm_stop="llm-serve stop"
alias llm_status="llm-serve status"
alias llm_logs="llm-serve logs"
alias llm_use_splash="llm-serve start splash4"

alias claude_local_splash="qwen-code --model splash4"
# Terminal chat via LM Studio's CLI; the app's Chat tab is the UI equivalent.
alias qwen_splash_chat="qwen-cli splash4"

# Claude Code via OpenRouter (defaults to stealth/ox-alpha)
alias claude_openrouter="openrouter-code"
alias claude_openrouter_ox_alpha="openrouter-code --model stealth/ox-alpha"
alias claude_ox_alpha="openrouter-code --model stealth/ox-alpha"

alias sleep_no="sudo pmset -a disablesleep 1"
alias sleep_ok="sudo pmset -a disablesleep 0"


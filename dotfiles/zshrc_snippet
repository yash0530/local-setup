# Aliases with dangerous flag (skip permission prompts)
alias agy="agy --dangerously-skip-permissions"

# Claude dispatcher. This replaces the old `alias claude=...`: an alias cannot
# take a subcommand, so routing `claude local <model>` or `claude open_router <model>`
# needs a function. `command claude` bypasses this function, so it does not recurse.
#   claude                                    Pro subscription (default)
#   claude open_router [ox_alpha|<model>]     OpenRouter (defaults to stealth/ox-alpha)
#   claude local qwen38_27 [--bits 4|5|6|8] [--think low|medium|xhigh]  Qwen 3.8 27B GGUF (default bits 5, think medium)
#   claude local qwen36_35                   Qwen 3.6 35B A3B (fast MoE)
#   claude local                              whatever model is already resident
#   claude subagent                           Pro + the opt-in local delegation subagent
# Every branch forwards "$@", so flags survive: `claude -p "..."`,
# `claude open_router ox_alpha -p "..."`, `claude local qwen38_27 --resume`, and so on.
claude() {
  case "${1:-}" in
    open_router|openrouter)
      shift
      case "${1:-}" in
        ox_alpha|ox-alpha|ox|oxalpha)
          shift
          openrouter-code --model "stealth/ox-alpha" "$@"
          ;;
        -*|"")
          openrouter-code --model "stealth/ox-alpha" "$@"
          ;;
        *)
          local _m="$1"
          shift
          openrouter-code --model "$_m" "$@"
          ;;
      esac
      ;;
    local)
      shift
      case "${1:-}" in
        qwen38_27|qwen38_27b)
          # Qwen 3.8 27B on GGUF (llama.cpp b10621+) — the recommended path since the
          # 2026-08 campaign: warm cache now holds deep, memory is flat, every quant is
          # usable (8-bit included, where MLX OOM'd/panicked). --bits picks the quant;
          # 5 (Q5_K_XL) is the default — the best balance of depth, memory headroom and
          # quality. 4 = fastest/most headroom, 6/8 = more quality (8 sits at the mem
          # edge). --think sets reasoning effort (Qwen 3.8: low|medium|xhigh, default
          # medium); it reloads the proxy so it also re-applies to an already-running
          # stack. See local_llm_bench/results/vacation-run/RECOMMENDATION.md.
          # For the snappy MLX path (2-4s trivial turns, <~50K ctx): qwen-code --model mlx4
          shift
          local _bits=5 _think=""
          while true; do
            case "${1:-}" in
              --bits)  _bits="${2:-5}"; shift 2 ;;
              --think) _think="${2:-}"; shift 2 ;;
              *) break ;;
            esac
          done
          local _m
          case "$_bits" in
            8) _m=gguf8 ;;
            6) _m=gguf6 ;;
            5) _m=gguf5 ;;
            4) _m=gguf4 ;;
            *) echo "claude local qwen38_27: --bits must be 4, 5, 6 or 8" >&2; return 1 ;;
          esac
          if [[ -n "$_think" ]]; then
            case "$_think" in
              low|medium|xhigh) ;;
              *) echo "claude local qwen38_27: --think must be low, medium or xhigh" >&2; return 1 ;;
            esac
            # bring up the right model, then reload the proxy with the chosen effort
            # (start_proxy no-ops if the proxy is already up, so restart-proxy is what
            # actually applies a change on a running stack).
            LLM_EFFORT="$_think" llm-serve start "$_m" >/dev/null 2>&1
            LLM_EFFORT="$_think" llm-serve restart-proxy >/dev/null 2>&1
          fi
          qwen-code --model "$_m" "$@"
          ;;
        qwen36_35) shift; qwen-code --model 35b "$@" ;;
        # A bare `claude local` means "whatever model is already resident", and
        # `claude local -p "..."` must still pass flags through. But an unrecognised
        # *word* here used to be forwarded to claude as the initial prompt, so a stale
        # shell or a typo turned `claude local qwen38_27` into a session whose first
        # message was the literal text "qwen38_27". Fail loudly instead.
        -*|"")     qwen-code "$@" ;;
        *)
          echo "claude local: unknown model '$1'" >&2
          echo "  expected: qwen38_27 [--bits 4|5|6|8] | qwen36_35" >&2
          echo "  (if this name looks right, run: source ~/.zshrc)" >&2
          return 1
          ;;
      esac
      ;;
    subagent) shift; claude-local-subagent "$@" ;;
    *)        command claude --dangerously-skip-permissions "$@" ;;
  esac
}

# Claude Code Auto-Resume Daemon
alias claude_resume="claude-resume"
alias claude_resume_logs="claude-resume logs"

# ------------------------------------------------------------------------------
# Local LLM stack (Qwen 3.8 27B via MLX; Qwen 3.6 35B A3B via llama-server)
# ------------------------------------------------------------------------------
# NOTE: ANTHROPIC_BASE_URL is deliberately NOT exported here. Exporting it would
# hijack the plain `claude` command and route your Claude Pro subscription to the
# local model. The local env is scoped inside the `qwen-code` wrapper only, so
# `claude` on its own always stays on your Pro subscription.

# Stack lifecycle (one model fits in 64 GB at a time; start = switch)
alias llm_start="llm-serve start"          # defaults to 35B A3B
alias llm_stop="llm-serve stop"
alias llm_status="llm-serve status"
alias llm_logs="llm-serve logs"
alias llm_use_27="llm-serve start mlx8"      # Qwen 3.8 27B, MLX 8-bit
alias llm_use_27_6b="llm-serve start mlx6"   # ~24% faster/turn, 7 GB smaller
alias llm_use_27_4b="llm-serve start mlx4"   # fastest; quality unmeasured
alias llm_use_35="llm-serve start 35b"

# Claude Code running entirely on a local model (pinned per alias)
alias claude_local_qwen_3.8_27="qwen-code --model mlx8"
alias claude_local_qwen_3.6_35="qwen-code --model 35b"
alias claude_local="qwen-code"             # whatever model is already resident

# Claude Code via OpenRouter (defaults to stealth/ox-alpha)
alias claude_openrouter="openrouter-code"
alias claude_openrouter_ox_alpha="openrouter-code --model stealth/ox-alpha"
alias claude_ox_alpha="openrouter-code --model stealth/ox-alpha"

# Claude Code on your Pro subscription, PLUS the local-qwen delegation subagent
# for this session only. Plain `claude` has no local subagent or skill at all --
# the local-llm plugin is loaded per-session via --plugin-dir, never installed.
alias claude_local_subagent="claude-local-subagent"

# One-shot prompts against the resident model (thinking off by default)
alias qwen_think="qwen --think"

# Raw llama.cpp escape hatches (bench-derived MTP draft depths).
# --mlock is not optional: without it macOS evicts model pages under memory
# pressure and prefill collapses (measured 196 -> 4 tok/s on an idle server).
# Qwen 3.8 wants temp 1.0 in thinking mode where 3.6 wanted 0.6, so the sampling
# differs per model here. KV stays fp16: quantizing it cost ~11% decode for no memory
# saving worth having, measured on this machine.
alias serve_qwen_38_27b="llama-server -m ~/Models/qwen3.8-27b-gguf/Qwen3.8-27B-Q8_0.gguf --spec-type draft-mtp --spec-draft-n-max 3 -c 65536 -ngl 99 -fa on -np 1 --mlock --jinja --reasoning-format deepseek --temp 1.0 --top-p 0.95 --top-k 20 --host 127.0.0.1 --port 8089"
alias serve_qwen_36_35b="llama-server -m ~/Models/qwen3.6-35b-a3b-mtp-q8/Qwen3.6-35B-A3B-Q8_0.gguf --spec-type draft-mtp --spec-draft-n-max 1 -c 65536 -ngl 99 -fa on -np 1 --mlock --jinja --reasoning-format deepseek --temp 0.6 --top-p 0.95 --top-k 20 --host 127.0.0.1 --port 8089"
alias llama_qwen_38_27b="llama-cli -m ~/Models/qwen3.8-27b-gguf/Qwen3.8-27B-Q8_0.gguf --spec-type draft-mtp --spec-draft-n-max 3 -n -1"
alias llama_qwen_36_35b="llama-cli -m ~/Models/qwen3.6-35b-a3b-mtp-q8/Qwen3.6-35B-A3B-Q8_0.gguf --spec-type draft-mtp --spec-draft-n-max 1 -n -1"

# Headless Server Sleep Management Aliases
# (Disables sleep to keep background daemons running, and lets you safely re-enable it)
alias sleep_no="sudo pmset -a disablesleep 1"
alias sleep_ok="sudo pmset -a disablesleep 0"


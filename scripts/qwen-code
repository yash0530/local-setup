#!/usr/bin/env bash
# qwen-code — Claude Code, but every token is generated by the local Qwen model.
#
# Claude Code speaks the Anthropic Messages API; llama-server speaks OpenAI. The
# llm-proxy shim translates between them, so pointing ANTHROPIC_BASE_URL at the
# proxy gives the local model the entire Claude Code tool loop — Read, Edit,
# Write, Bash, Grep, subagents, the lot.
#
#   qwen-code                      interactive session on the local model
#   qwen-code -p "fix the lint"    headless one-shot
#   qwen-code --model gguf5 -p "..." switch model first, then run
#   qwen-code --think low -p "..."    reasoning effort: xhigh (default) | medium | low
#                                     (also high/max -> xhigh, med -> medium, minimal -> low)
#
# Every other argument is passed through to `claude` untouched.

set -euo pipefail

PROXY_PORT="${PROXY_PORT:-8790}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Optional leading --model / --think, in either order. --model switches which model is
# loaded before we start; --think sets the reasoning effort (default xhigh, or
# $LLM_EFFORT).
WANT_MODEL=""
WANT_EFFORT="${LLM_EFFORT:-xhigh}"
while true; do
  case "${1:-}" in
    --model) WANT_MODEL="${2:-}"; shift 2 ;;
    --think) WANT_EFFORT="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
# Map onto the model's three real levels (the template rejects anything else).
case "$(echo "$WANT_EFFORT" | tr 'A-Z' 'a-z')" in
  xhigh|high|max|x-high|extra-high) WANT_EFFORT=xhigh ;;
  medium|med|default)                WANT_EFFORT=medium ;;
  low|minimal|min)                   WANT_EFFORT=low ;;
  *) echo "qwen-code: --think must be xhigh, medium or low (got '$WANT_EFFORT')" >&2; exit 2 ;;
esac
export LLM_EFFORT="$WANT_EFFORT"

if [[ -n "$WANT_MODEL" ]]; then
  "${SCRIPT_DIR}/llm-serve" start "$WANT_MODEL"
elif ! curl -sf "http://127.0.0.1:${PROXY_PORT}/health" >/dev/null 2>&1; then
  echo "local stack not running — starting it" >&2
  "${SCRIPT_DIR}/llm-serve" start
fi

# The effort lives in the proxy (it stamps reasoning_effort on every request), so a
# proxy started earlier at another level would silently keep it. Restart just the
# proxy when it differs — the model stays resident, so this costs about a second.
# Note it applies to every session sharing this stack, not only this one.
CUR_EFFORT="$(curl -sf --max-time 5 "http://127.0.0.1:${PROXY_PORT}/health" 2>/dev/null \
  | sed -n 's/.*"effort":"\([a-z]*\)".*/\1/p')"
if [[ "$CUR_EFFORT" != "$WANT_EFFORT" ]]; then
  echo "reasoning effort -> ${WANT_EFFORT} (was ${CUR_EFFORT:-unset}); restarting proxy" >&2
  "${SCRIPT_DIR}/llm-serve" restart-proxy >/dev/null
fi

# ANTHROPIC_API_KEY would take precedence over ANTHROPIC_AUTH_TOKEN and send
# real traffic to Anthropic, so it is explicitly cleared for this process.
unset ANTHROPIC_API_KEY

# API_TIMEOUT_MS bounds the whole request; the two idle-timeout vars below bound
# the gap between streamed chunks, which is a different watchdog. A cold 141K
# prefill measured 660s at 214 tok/s here, blowing past the 180s byte watchdog
# long before the request timeout mattered -> "Stream idle timeout - no chunks
# received". 1800000 is the byte watchdog's hard ceiling. Note that
# CLAUDE_STREAM_IDLE_TIMEOUT_MS is a floor, max(env, 300000): it can only be
# raised above 5 min, never lowered.
exec env \
  ANTHROPIC_BASE_URL="http://127.0.0.1:${PROXY_PORT}" \
  ANTHROPIC_AUTH_TOKEN="local" \
  ANTHROPIC_MODEL="qwen-local" \
  ANTHROPIC_SMALL_FAST_MODEL="qwen-local" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen-local" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${LLM_CTX:-262144}" \
  `# Matches the server's -c capacity (262144) — no Claude-Code-side throttle; the` \
  `# engine's memory ceiling is the real limiter now. These are ESTIMATED tokens` \
  `# (count_tokens uses chars/3.5, which overshoots real), and Claude Code hard-rejects` \
  `# single prompts past ~200k est, so real ctx in practice tops out well under 262144.` \
  `# On gguf8 real ctx OOMs SILENTLY (empty turns) at the ~156k / 50 GB-wired edge, so` \
  `# run gguf5 (safe to ~200k) to actually use the full window; on gguf8 the ~156k edge` \
  `# is the effective stop. History: the old mlx4+APC path OOM'd at ~40-50k real (APC` \
  `# snapshot clones, apc.py:321; mlx6 kernel-panicked, IOGPUMemory.cpp:550) and needed` \
  `# a hard 81920 cap here; llama.cpp/GGUF has no such snapshot OOM, so it was lifted.` \
  `# Do NOT set below 65536 est — 49152 and 40960 block fresh sessions client-side.` \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  API_TIMEOUT_MS="${API_TIMEOUT_MS:-1800000}" \
  CLAUDE_STREAM_IDLE_TIMEOUT_MS="${CLAUDE_STREAM_IDLE_TIMEOUT_MS:-1800000}" \
  CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS="${CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS:-1800000}" \
  MAX_THINKING_TOKENS=0 \
  claude "$@"

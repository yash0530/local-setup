#!/usr/bin/env bash
# qwen-code — Claude Code, but every token is generated by the local Qwen model.
#
# Points ANTHROPIC_BASE_URL at llm-proxy (Anthropic <-> OpenAI), so the local model gets
# Claude Code's whole tool loop.
#
#   qwen-code                          interactive session on the local model
#   qwen-code -p "fix the lint"        headless one-shot
#   qwen-code --model gguf5 -p "..."   switch model first (gguf5|gguf6|gguf8|splash4)
#   qwen-code --think low -p "..."     reasoning effort: xhigh (default) | medium | low
#
# Every other argument is passed through to `claude` untouched.

set -euo pipefail

PROXY_PORT="${PROXY_PORT:-8790}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Optional leading --model / --think, in either order.
WANT_MODEL=""
WANT_EFFORT="${LLM_EFFORT:-xhigh}"
while true; do
  case "${1:-}" in
    --model) WANT_MODEL="${2:-}"; shift 2 ;;
    --think) WANT_EFFORT="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
# Map onto the model's three real levels (the template rejects anything else).
case "$(echo "$WANT_EFFORT" | tr 'A-Z' 'a-z')" in
  xhigh|high|max|x-high|extra-high) WANT_EFFORT=xhigh ;;
  medium|med|default)                WANT_EFFORT=medium ;;
  low|minimal|min)                   WANT_EFFORT=low ;;
  *) echo "qwen-code: --think must be xhigh, medium or low (got '$WANT_EFFORT')" >&2; exit 2 ;;
esac
export LLM_EFFORT="$WANT_EFFORT"

if [[ -n "$WANT_MODEL" ]]; then
  "${SCRIPT_DIR}/llm-serve" start "$WANT_MODEL"
elif ! curl -sf "http://127.0.0.1:${PROXY_PORT}/health" >/dev/null 2>&1; then
  echo "local stack not running — starting it" >&2
  "${SCRIPT_DIR}/llm-serve" start
fi

# The proxy stamps the effort on every request, so restart just the proxy when it
# differs (about a second). This affects every session sharing the stack.
CUR_EFFORT="$(curl -sf --max-time 5 "http://127.0.0.1:${PROXY_PORT}/health" 2>/dev/null \
  | sed -n 's/.*"effort":"\([a-z]*\)".*/\1/p')"
if [[ "$CUR_EFFORT" != "$WANT_EFFORT" ]]; then
  echo "reasoning effort -> ${WANT_EFFORT} (was ${CUR_EFFORT:-unset}); restarting proxy" >&2
  "${SCRIPT_DIR}/llm-serve" restart-proxy >/dev/null
fi

# ANTHROPIC_API_KEY would take precedence over ANTHROPIC_AUTH_TOKEN and send
# real traffic to Anthropic, so it is explicitly cleared for this process.
unset ANTHROPIC_API_KEY

# The idle-timeout vars bound the gap between streamed chunks, separately from
# API_TIMEOUT_MS; a deep cold prefill (660 s at 141k measured) trips them otherwise.
# 1800000 is the byte watchdog's ceiling; the chunk one is a floor, max(env, 300000).
#
# CLAUDE_CODE_MAX_CONTEXT_TOKENS matches the server's -c. It is in ESTIMATED tokens
# (chars/3.5, overshoots real). gguf8 OOMs silently (empty turns) near 156k real, so use
# gguf5 or splash4 for deep sessions. Below 65536 blocks fresh sessions client-side.
exec env \
  ANTHROPIC_BASE_URL="http://127.0.0.1:${PROXY_PORT}" \
  ANTHROPIC_AUTH_TOKEN="local" \
  ANTHROPIC_MODEL="qwen-local" \
  ANTHROPIC_SMALL_FAST_MODEL="qwen-local" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen-local" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${LLM_CTX:-262144}" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  API_TIMEOUT_MS="${API_TIMEOUT_MS:-1800000}" \
  CLAUDE_STREAM_IDLE_TIMEOUT_MS="${CLAUDE_STREAM_IDLE_TIMEOUT_MS:-1800000}" \
  CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS="${CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS:-1800000}" \
  MAX_THINKING_TOKENS=0 \
  claude "$@"

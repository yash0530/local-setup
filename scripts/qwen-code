#!/usr/bin/env bash
# qwen-code — Claude Code, but every token is generated by the local Qwen model.
#
# Claude Code speaks the Anthropic Messages API; llama-server speaks OpenAI. The
# llm-proxy shim translates between them, so pointing ANTHROPIC_BASE_URL at the
# proxy gives the local model the entire Claude Code tool loop — Read, Edit,
# Write, Bash, Grep, subagents, the lot.
#
#   qwen-code                      interactive session on the local model
#   qwen-code -p "fix the lint"    headless one-shot
#   qwen-code --model 27b -p "..." switch model first, then run
#
# Every other argument is passed through to `claude` untouched.

set -euo pipefail

PROXY_PORT="${PROXY_PORT:-8790}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Optional leading --model switches which GGUF is loaded before we start.
WANT_MODEL=""
if [[ "${1:-}" == "--model" ]]; then
  WANT_MODEL="${2:-}"
  shift 2
fi

if [[ -n "$WANT_MODEL" ]]; then
  "${SCRIPT_DIR}/llm-serve" start "$WANT_MODEL"
elif ! curl -sf "http://127.0.0.1:${PROXY_PORT}/health" >/dev/null 2>&1; then
  echo "local stack not running — starting it" >&2
  "${SCRIPT_DIR}/llm-serve" start
fi

# ANTHROPIC_API_KEY would take precedence over ANTHROPIC_AUTH_TOKEN and send
# real traffic to Anthropic, so it is explicitly cleared for this process.
unset ANTHROPIC_API_KEY

exec env \
  ANTHROPIC_BASE_URL="http://127.0.0.1:${PROXY_PORT}" \
  ANTHROPIC_AUTH_TOKEN="local" \
  ANTHROPIC_MODEL="qwen-local" \
  ANTHROPIC_SMALL_FAST_MODEL="qwen-local" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen-local" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${LLM_CTX:-262144}" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  API_TIMEOUT_MS="${API_TIMEOUT_MS:-1800000}" \
  MAX_THINKING_TOKENS=0 \
  claude "$@"

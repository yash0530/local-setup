#!/usr/bin/env bash
# qwen-code — Claude Code, but every token is generated by the local Qwen model.
#
# Claude Code speaks the Anthropic Messages API; llama-server speaks OpenAI. The
# llm-proxy shim translates between them, so pointing ANTHROPIC_BASE_URL at the
# proxy gives the local model the entire Claude Code tool loop — Read, Edit,
# Write, Bash, Grep, subagents, the lot.
#
#   qwen-code                      interactive session on the local model
#   qwen-code -p "fix the lint"    headless one-shot
#   qwen-code --model 27b -p "..." switch model first, then run
#
# Every other argument is passed through to `claude` untouched.

set -euo pipefail

PROXY_PORT="${PROXY_PORT:-8790}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Optional leading --model switches which GGUF is loaded before we start.
WANT_MODEL=""
if [[ "${1:-}" == "--model" ]]; then
  WANT_MODEL="${2:-}"
  shift 2
fi

if [[ -n "$WANT_MODEL" ]]; then
  "${SCRIPT_DIR}/llm-serve" start "$WANT_MODEL"
elif ! curl -sf "http://127.0.0.1:${PROXY_PORT}/health" >/dev/null 2>&1; then
  echo "local stack not running — starting it" >&2
  "${SCRIPT_DIR}/llm-serve" start
fi

# ANTHROPIC_API_KEY would take precedence over ANTHROPIC_AUTH_TOKEN and send
# real traffic to Anthropic, so it is explicitly cleared for this process.
unset ANTHROPIC_API_KEY

# API_TIMEOUT_MS bounds the whole request; the two idle-timeout vars below bound
# the gap between streamed chunks, which is a different watchdog. A cold 141K
# prefill measured 660s at 214 tok/s here, blowing past the 180s byte watchdog
# long before the request timeout mattered -> "Stream idle timeout - no chunks
# received". 1800000 is the byte watchdog's hard ceiling. Note that
# CLAUDE_STREAM_IDLE_TIMEOUT_MS is a floor, max(env, 300000): it can only be
# raised above 5 min, never lowered.
exec env \
  ANTHROPIC_BASE_URL="http://127.0.0.1:${PROXY_PORT}" \
  ANTHROPIC_AUTH_TOKEN="local" \
  ANTHROPIC_MODEL="qwen-local" \
  ANTHROPIC_SMALL_FAST_MODEL="qwen-local" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen-local" \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS="${LLM_CTX:-81920}" \
  `# 65536 (estimated tokens), not the model's 262144: on mlx4+APC the Metal OOMs from APC's snapshot` \
  `# clone (apc.py:321) start sporadically at ~40-50k real ctx and are total by ~75k` \
  `# (vacation-run arm 1, 2026-08-28); on mlx6 the same pressure kernel-panicked the` \
  `# machine (IOGPUMemory.cpp:550). Capping makes Claude Code compact before the` \
  `# danger zone. The count_tokens estimate (chars/3.5) overshoots real tokens, so` \
  `# 40960 and 49152 both blocked fresh sessions ("Prompt is too long" client-side);` \
  `# at 65536 estimated, real ctx topped out ~35-45k. Raised to 81920 after` \
  `# apply-single-clone-patch cut the per-store transient spike ~1/3 (2026-08-29),` \
  `# moving the expected OOM onset to ~55-70k real.` \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  API_TIMEOUT_MS="${API_TIMEOUT_MS:-1800000}" \
  CLAUDE_STREAM_IDLE_TIMEOUT_MS="${CLAUDE_STREAM_IDLE_TIMEOUT_MS:-1800000}" \
  CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS="${CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS:-1800000}" \
  MAX_THINKING_TOKENS=0 \
  claude "$@"

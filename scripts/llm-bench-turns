#!/usr/bin/env bash
# llm-bench-turns — drive a real Claude Code session of N back-to-back turns against the
# resident local model, and record what the server actually did on each turn.
#
#   llm-bench-turns <arm-label> [bits]
#
# Why a real session instead of a synthetic replay: the thing under test is prompt-cache
# behaviour under Claude Code's ACCESS PATTERN, and that pattern is the point — each turn
# issues several requests (the turn itself, every tool call, background recaps), and each
# request stores its own snapshots. A scripted single-request-per-turn replay cannot
# reproduce the eviction pressure that makes the cache miss in practice.
#
# Metrics come from the server's own log rather than from wall-clock around the client,
# because the client's wall time folds in tool execution, and because cached_tokens is
# only visible server-side. Note that APC's own stats_snapshot()["resident_bytes"] is
# useless here — in exact mode it walks only the block pool (apc.py:3456) and reports 0 no
# matter how much KV is held — so process RSS is sampled instead.

set -euo pipefail

ARM="${1:?usage: llm-bench-turns <arm-label> [bits]}"
BITS="${2:-}"

REPO="${HOME}/Desktop/Programming/local-setup"
STATE_DIR="${HOME}/.local/state/local-llm"
SERVER_LOG="${STATE_DIR}/logs/server.log"
OUT_DIR="${REPO}/bench-results"
OUT="${OUT_DIR}/${ARM}.jsonl"
LLAMA_PORT="${LLAMA_PORT:-8089}"

mkdir -p "$OUT_DIR"
: >"$OUT"
: >"${OUT_DIR}/${ARM}.cachestats.jsonl"

REQ_TMP="$(mktemp -t llmbench-req)"
PREF_TMP="$(mktemp -t llmbench-pref)"
trap 'rm -f "$REQ_TMP" "$PREF_TMP"' EXIT

QUESTIONS=(
  "In this repo, what does scripts/llm-serve do? List every model alias it accepts and which inference engine each one routes to."
  "Explain the difference between the MLX launch path and the llama.cpp launch path in llm-serve. Which flags does each one pass that the other does not?"
  "What is APC, and why does this model run it in 'exact' mode rather than 'block' mode? Explain what property of the architecture forces that."
  "Why does each prefill store TWO cache entries rather than one? What is APC_EXACT_PREFIX_GUARD_TOKENS for?"
  "Read dotfiles/zshrc_snippet and explain what the claude() dispatcher function does. Why is it a function and not an alias?"
  "How does scripts/llm-proxy.mjs translate between the Anthropic Messages API and the OpenAI chat completions API? What does it do with the model name?"
  "What happens to WebSearch and WebFetch when running on the local stack? Why can't the local model just call them itself?"
  "Explain how the claude-resume daemon detects a rate limit and how it resumes the session afterwards."
  "Why was MTP (speculative decoding) defaulted to off on the MLX path? Do you agree with that reasoning based on what you can see in the repo?"
  "Using the model's config.json in ~/Models/qwen3.8-27b-mlx-4bit, calculate the KV cache size per token for this model. Show your arithmetic."
  "What would actually happen if I set LLM_APC_ENTRIES=0? Trace it through the code and tell me whether that means 'unlimited' or something else."
  "Summarize the three biggest risks in this whole local-LLM setup and how you would mitigate each one."
)

# Snapshot the log position so a turn's requests can be isolated from prior traffic.
line_count() { wc -l <"$SERVER_LOG" 2>/dev/null | tr -d ' ' || echo 0; }

cache_stats() {
  curl -sf --max-time 5 "http://127.0.0.1:${LLAMA_PORT}/v1/cache/stats" 2>/dev/null || echo '{}'
}

server_rss_gb() {
  local pid; pid="$(cat "${STATE_DIR}/server.pid" 2>/dev/null || true)"
  [[ -n "$pid" ]] && ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.2f", $1/1048576}' || echo "null"
}

free_ram_gb() {
  # page-level accounting; memory_pressure's own summary line is a percentage, not bytes.
  vm_stat | awk '/page size of/{ps=$8} /Pages free/{f=$3} /Pages inactive/{i=$3}
                 END{gsub(/\./,"",f); gsub(/\./,"",i); printf "%.2f", (f+i)*ps/1073741824}'
}

cd "$REPO"

echo "arm=$ARM  bits=${BITS:-resident}  turns=${#QUESTIONS[@]}  out=$OUT" >&2
echo "model: $(cat "${STATE_DIR}/current" 2>/dev/null || echo unknown)" >&2

for i in "${!QUESTIONS[@]}"; do
  turn=$((i + 1))
  q="${QUESTIONS[$i]}"
  before="$(line_count)"
  t0=$(date +%s)

  # Turn 1 opens the session; every later turn continues it with -c so the conversation
  # (and therefore the prompt prefix) grows exactly the way real work does.
  if [[ $turn -eq 1 ]]; then
    set -- -p "$q"
  else
    set -- -c -p "$q"
  fi

  if ! "${REPO}/scripts/qwen-code" --dangerously-skip-permissions "$@" \
        >"${OUT_DIR}/${ARM}.turn${turn}.txt" 2>"${OUT_DIR}/${ARM}.turn${turn}.err"; then
    echo "  turn $turn: client FAILED (see ${ARM}.turn${turn}.err)" >&2
  fi

  t1=$(date +%s)
  wall=$((t1 - t0))
  after="$(line_count)"

  # Aggregate every server request this turn produced, then emit one row per turn with the
  # per-request detail inlined — a turn is the unit the user experiences, but a request is
  # the unit the cache sees.
  tail -n +$((before + 1)) "$SERVER_LOG" \
    | grep 'Request completed' \
    | sed -E 's/.*prompt_tokens=([0-9]+) generated_tokens=([0-9]+) elapsed=([0-9.]+)s prefill=([0-9.]+) tok\/s decode=([0-9.]+) tok\/s finish_reason=([a-z_]+) in_flight=([0-9]+).*/\1 \2 \3 \4 \5 \6 \7/' \
    > "$REQ_TMP" || true

  tail -n +$((before + 1)) "$SERVER_LOG" \
    | grep 'Prefill completed' \
    | sed -E 's/.*prompt_tokens=([0-9]+) cached_tokens=([0-9]+).*/\1 \2/' \
    > "$PREF_TMP" || true

  python3 - "$turn" "$wall" "$ARM" "$(server_rss_gb)" "$(free_ram_gb)" "$REQ_TMP" "$PREF_TMP" <<'PY' >>"$OUT"
import json, sys
turn, wall, arm, rss, freeram, req_path, pref_path = sys.argv[1:8]
def rows(p):
    try:
        return [l.split() for l in open(p) if l.strip()]
    except OSError:
        return []
reqs = rows(req_path)
pref = rows(pref_path)
requests = [
    {"prompt_tokens": int(r[0]), "generated_tokens": int(r[1]), "elapsed_s": float(r[2]),
     "prefill_tps": float(r[3]), "decode_tps": float(r[4]), "finish": r[5],
     "in_flight": int(r[6])}
    for r in reqs if len(r) >= 7
]
prefills = [{"prompt_tokens": int(p[0]), "cached_tokens": int(p[1])} for p in pref if len(p) >= 2]
warm = [p for p in prefills if p["cached_tokens"] > 0.5 * p["prompt_tokens"]]
dec = [r["decode_tps"] for r in requests]
print(json.dumps({
    "arm": arm, "turn": int(turn), "wall_s": int(wall),
    "n_requests": len(requests), "n_prefills": len(prefills),
    "n_warm_prefills": len(warm), "n_cold_prefills": len(prefills) - len(warm),
    "cached_frac": (sum(p["cached_tokens"] for p in prefills) /
                    max(1, sum(p["prompt_tokens"] for p in prefills))),
    "max_prompt_tokens": max([r["prompt_tokens"] for r in requests], default=0),
    "total_generated": sum(r["generated_tokens"] for r in requests),
    "decode_tps_mean": (sum(dec) / len(dec)) if dec else None,
    "decode_tps_min": min(dec) if dec else None,
    "decode_tps_max": max(dec) if dec else None,
    "server_rss_gb": None if rss == "null" else float(rss),
    "free_ram_gb": float(freeram),
    "requests": requests, "prefills": prefills,
}))
PY

  # Cache stats are a separate line so a schema change upstream cannot break the main row.
  printf '{"arm":"%s","turn":%d,"cache_stats":%s}\n' "$ARM" "$turn" "$(cache_stats)" \
    >>"${OUT_DIR}/${ARM}.cachestats.jsonl"

  echo "  turn $turn/${#QUESTIONS[@]}  wall=${wall}s  rss=$(server_rss_gb)GB  free=$(free_ram_gb)GB" >&2
done

echo "done: $OUT" >&2

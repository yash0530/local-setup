#!/usr/bin/env bash
# llm-serve — start/stop the local LLM stack (oMLX / LM Studio Splash + Anthropic proxy).
#
#   llm-serve start [ornith35|inkling2|daisyrose27|splash4]
#     ornith35     Ornith-1.5-35B-A3B oQ4e-mtp on oMLX v0.8.1 + MTP (default)
#     inkling2     Thinking Machines Inkling-2-Mini oQ3e-mtp on oMLX + DSpark (TF32=0)
#     daisyrose27  DaisyRose-27B (pure-RL Qwen 3.8) oQ4e-mtp on oMLX + MTP
#     splash4      incoai/Qwen3.8-27B-Splash (4-bit + DFlash2) on LM Studio Splash
#   llm-serve stop              stop everything
#   llm-serve status            what's running, and whether it answers
#   llm-serve restart [model]   stop then start
#   llm-serve restart-proxy     reload just the proxy (keeps the model resident)
#   llm-serve logs [server|proxy]  tail a log
#   llm-serve which             the currently-loaded model

set -euo pipefail

STATE_DIR="${HOME}/.local/state/local-llm"
LOG_DIR="${STATE_DIR}/logs"
mkdir -p "$LOG_DIR"

SERVER_PID="${STATE_DIR}/server.pid"
PROXY_PID="${STATE_DIR}/proxy.pid"
CURRENT="${STATE_DIR}/current"
ENGINE_FILE="${STATE_DIR}/engine"
UPSTREAM_MODEL_FILE="${STATE_DIR}/upstream_model"
FAMILY_FILE="${STATE_DIR}/family"
CTX_FILE="${STATE_DIR}/ctx"
TEMP_FILE="${STATE_DIR}/temp"
TOP_P_FILE="${STATE_DIR}/top_p"

SERVER_LOG="${LOG_DIR}/server.log"
PROXY_LOG="${LOG_DIR}/proxy.log"
BRAVE_KEY_FILE="${HOME}/.config/local-llm/brave_api_key"

OMLX_BASE="${STATE_DIR}/omlx-base"
OMLX_MODELS="${STATE_DIR}/omlx-models"
OMLX_CACHE="${STATE_DIR}/omlx-cache"

LLAMA_PORT="${LLAMA_PORT:-8089}"
PROXY_PORT="${PROXY_PORT:-8790}"

# --- model registry ------------------------------------------------------------
MODEL_ALIASES="ornith35 inkling2 daisyrose27 splash4"
DEFAULT_MODEL="ornith35"

canonical_model() {
  case "$(echo "${1:-}" | tr 'A-Z' 'a-z')" in
    "" ) echo "$DEFAULT_MODEL" ;;
    ornith35|ornith|ornith_35b|ornith-35b)       echo "ornith35" ;;
    inkling2|inkling2_mini|inkling|inkling2-oq3e) echo "inkling2" ;;
    daisyrose27|daisyrose|daisyrose_27b|daisyrose-27b) echo "daisyrose27" ;;
    splash4|qwen38_27|qwen38_27b)                echo "splash4" ;;
    *) return 1 ;;
  esac
}

model_engine() {
  case "$1" in
    splash4) echo "splash" ;;
    ornith35|inkling2|daisyrose27) echo "omlx" ;;
    *) return 1 ;;
  esac
}

model_family() {
  case "$1" in
    inkling2) echo "inkling2" ;;
    ornith35|daisyrose27|splash4) echo "qwen3.8" ;;
    *) echo "qwen3.8" ;;
  esac
}

model_dir() {
  local base="${LLM_MODELS_DIR:-${HOME}/Models}"
  case "$1" in
    ornith35)    echo "${base}/ornith-35b-a3b-oq4e-mtp" ;;
    inkling2)    echo "${base}/inkling2-mini-oq3e-mtp" ;;
    daisyrose27) echo "${base}/daisyrose-27b-oq4e-mtp" ;;
    *) return 1 ;;
  esac
}

model_ctx() {
  case "$1" in
    ornith35)    echo "${LLM_ORNITH_CTX:-${LLM_CTX:-262144}}" ;;
    inkling2)    echo "${LLM_INKLING_CTX:-${LLM_CTX:-131072}}" ;;
    daisyrose27) echo "${LLM_DAISY_CTX:-${LLM_CTX:-131072}}" ;;
    splash4)     echo "${LLM_SPLASH_CTX:-${LLM_CTX:-262144}}" ;;
    *) echo "${LLM_CTX:-262144}" ;;
  esac
}

model_temp() {
  echo "1.0"
}

model_top_p() {
  case "$1" in
    inkling2) echo "1.0" ;;
    *) echo "0.95" ;;
  esac
}

model_upstream_id() {
  case "$1" in
    splash4) echo "qwen-local" ;;
    *) echo "$1" ;;
  esac
}

model_splash_key() {
  case "$1" in
    splash4) echo "local/qwen3.8-27b-splash" ;;
    *) return 1 ;;
  esac
}

normalize_effort() { # <effort> <family>
  local eff fam
  eff="$(echo "${1:-xhigh}" | tr 'A-Z' 'a-z')"
  fam="${2:-qwen3.8}"
  if [[ "$fam" == "inkling2" ]]; then
    case "$eff" in
      none|off|0)                      echo none ;;
      minimal|min)                     echo minimal ;;
      low)                             echo low ;;
      medium|med|default)              echo medium ;;
      high)                            echo high ;;
      xhigh|max|x-high|extra-high)     echo xhigh ;;
      *) echo "invalid inkling2 reasoning effort '${1:-}' (expected none|minimal|low|medium|high|xhigh)" >&2; return 1 ;;
    esac
  else
    case "$eff" in
      xhigh|high|max|x-high|extra-high) echo xhigh ;;
      medium|med|default)                echo medium ;;
      low|minimal|min)                   echo low ;;
      *) echo "invalid reasoning effort '${1:-}' (expected low, medium or xhigh)" >&2; return 1 ;;
    esac
  fi
}

# Resolve real script dir so relative dotfiles paths work even via ~/.local/bin symlink.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link="$(readlink "$_self")"
  [[ "$_link" == /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
PROXY_JS="${SCRIPT_DIR}/llm-proxy.mjs"

LMS="${LLM_LMS:-$(command -v lms 2>/dev/null || echo "${HOME}/.lmstudio/bin/lms")}"
SPLASH_BASE_NAME="Qwen3.8-27B-Splash"
SPLASH_VIRTUAL_SRC="$(cd "$SCRIPT_DIR/.." && pwd)/dotfiles/lmstudio/qwen3.8-27b-splash"
SPLASH_VIRTUAL_DST="${HOME}/.lmstudio/hub/models/local/qwen3.8-27b-splash"

find_omlx_cli() {
  if [[ -n "${LLM_OMLX_CLI:-}" && -x "${LLM_OMLX_CLI}" ]]; then
    echo "${LLM_OMLX_CLI}"
  elif [[ -x "/Applications/oMLX.app/Contents/MacOS/omlx-cli" ]]; then
    echo "/Applications/oMLX.app/Contents/MacOS/omlx-cli"
  elif command -v omlx-cli >/dev/null 2>&1; then
    command -v omlx-cli
  else
    return 1
  fi
}

ensure_splash_virtual_model() {
  local f changed=0
  mkdir -p "$SPLASH_VIRTUAL_DST"
  for f in manifest.json model.yaml; do
    [[ -f "$SPLASH_VIRTUAL_SRC/$f" ]] || { echo "missing $SPLASH_VIRTUAL_SRC/$f" >&2; return 1; }
    if ! cmp -s "$SPLASH_VIRTUAL_SRC/$f" "$SPLASH_VIRTUAL_DST/$f"; then
      cp "$SPLASH_VIRTUAL_SRC/$f" "$SPLASH_VIRTUAL_DST/$f"; changed=1
    fi
  done
  if [[ $changed == 1 ]]; then
    echo "  installed LM Studio virtual model local/qwen3.8-27b-splash"
    sleep 3
  fi
}

clear_state_metadata() {
  rm -f "$CURRENT" "$ENGINE_FILE" "$UPSTREAM_MODEL_FILE" "$FAMILY_FILE" "$CTX_FILE" "$TEMP_FILE" "$TOP_P_FILE"
}

write_state_metadata() {
  local alias="$1"
  local eng fam upstream ctx temp top_p
  eng="$(model_engine "$alias")"
  fam="$(model_family "$alias")"
  upstream="$(model_upstream_id "$alias")"
  ctx="$(model_ctx "$alias")"
  temp="$(model_temp "$alias")"
  top_p="$(model_top_p "$alias")"
  echo "$alias" >"$CURRENT"
  echo "$eng" >"$ENGINE_FILE"
  echo "$upstream" >"$UPSTREAM_MODEL_FILE"
  echo "$fam" >"$FAMILY_FILE"
  echo "$ctx" >"$CTX_FILE"
  echo "$temp" >"$TEMP_FILE"
  echo "$top_p" >"$TOP_P_FILE"
}

is_running() { # pidfile
  [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null
}

adopt_orphan() { # port pidfile
  local pid
  pid="$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1)"
  [[ -n "$pid" ]] || return 1
  echo "  adopting orphaned process on :$1 (pid $pid)" >&2
  echo "$pid" >"$2"
}

reconcile() {
  is_running "$SERVER_PID" || adopt_orphan "$LLAMA_PORT" "$SERVER_PID" || true
  is_running "$PROXY_PID" || adopt_orphan "$PROXY_PORT" "$PROXY_PID" || true

  if is_running "$SERVER_PID" && [[ ! -s "$CURRENT" ]]; then
    local argv
    argv="$(ps -o command= -p "$(cat "$SERVER_PID")" 2>/dev/null || true)"
    case "$argv" in
      *"LM Studio"*|*lmstudio*|*llmster*)
        write_state_metadata "splash4"
        ;;
      *omlx*)
        local link alias=""
        for link in "${OMLX_MODELS}/"*; do
          [[ -e "$link" ]] && alias="$(basename "$link")" && break
        done
        if [[ -n "$alias" ]] && canonical_model "$alias" >/dev/null 2>&1; then
          write_state_metadata "$(canonical_model "$alias")"
        else
          echo "omlx" >"$ENGINE_FILE"
        fi
        ;;
    esac
  fi
}

detach() { # cmd args...
  exec perl -e 'use POSIX (); POSIX::setsid(); exec @ARGV or die "exec failed: $!"' -- "$@"
}

stop_pidfile() { # pidfile label
  if is_running "$1"; then
    local pid; pid="$(cat "$1")"
    echo "  stopping $2 (pid $pid)"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
      done
    fi
  fi
  rm -f "$1"
}

port_in_use() { # port
  netstat -an -p tcp 2>/dev/null | awk -v suffix=".$1" '
    NR > 2 && length($4) > length(suffix) &&
    substr($4, length($4) - length(suffix) + 1) == suffix { found = 1 }
    END { exit !found }'
}

wait_port_free() { # port
  port_in_use "$1" || return 0
  echo "  waiting for port $1 to clear"
  for _ in $(seq 1 60); do
    sleep 0.5
    port_in_use "$1" || return 0
  done
  echo "  port $1 still held after 30s:" >&2
  netstat -an -p tcp 2>/dev/null | awk -v suffix=".$1" '
    NR > 2 && length($4) > length(suffix) &&
    substr($4, length($4) - length(suffix) + 1) == suffix' >&2
  return 1
}

HEALTH_URL="http://127.0.0.1:${LLAMA_PORT}/v1/models"

stop_server() {
  local eng argv=""
  eng="$(cat "$ENGINE_FILE" 2>/dev/null || echo "")"
  if is_running "$SERVER_PID"; then
    argv="$(ps -o command= -p "$(cat "$SERVER_PID")" 2>/dev/null || true)"
  fi

  if [[ "$eng" == "splash" || "$argv" == *"LM Studio"* || "$argv" == *lmstudio* || "$argv" == *llmster* ]]; then
    if [[ -x "$LMS" ]]; then
      echo "  unloading LM Studio model and stopping its server"
      "$LMS" unload --all >/dev/null 2>&1 || true
      "$LMS" server stop >/dev/null 2>&1 || true
    fi
    rm -f "$SERVER_PID"
  fi

  if is_running "$SERVER_PID"; then
    stop_pidfile "$SERVER_PID" "model server"
  else
    rm -f "$SERVER_PID"
  fi

  # Safety sweep if anything non-LM-Studio is still holding :LLAMA_PORT
  local stray
  stray="$(lsof -nP -iTCP:"$LLAMA_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 || true)"
  if [[ -n "$stray" ]]; then
    local s_cmd; s_cmd="$(ps -o command= -p "$stray" 2>/dev/null || true)"
    if [[ "$s_cmd" == *omlx* || "$s_cmd" == *llama* ]]; then
      echo "  stopping remaining listener on :${LLAMA_PORT} (pid $stray)"
      kill "$stray" 2>/dev/null || true
      sleep 1
    fi
  fi
}

wait_healthy() {
  for _ in $(seq 1 300); do
    if curl -sf --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then return 0; fi
    if ! is_running "$SERVER_PID"; then
      echo "  model server died on startup — last lines:" >&2
      tail -20 "$SERVER_LOG" >&2
      return 1
    fi
    sleep 1
  done
  echo "  timed out waiting for the model server to become healthy" >&2
  return 1
}

start_proxy() {
  if is_running "$PROXY_PID"; then return 0; fi
  if ! node -v >/dev/null 2>&1; then
    echo "  proxy failed to start: node runtime is broken or missing (e.g. dyld library mismatch)" >&2
    echo "  try: brew upgrade node (or brew reinstall node)" >&2
    return 1
  fi
  local cur fam upstream temp top_p effort
  cur="$(cat "$CURRENT" 2>/dev/null || echo "$DEFAULT_MODEL")"
  fam="$(cat "$FAMILY_FILE" 2>/dev/null || model_family "$cur")"
  upstream="$(cat "$UPSTREAM_MODEL_FILE" 2>/dev/null || model_upstream_id "$cur")"
  temp="$(cat "$TEMP_FILE" 2>/dev/null || model_temp "$cur")"
  top_p="$(cat "$TOP_P_FILE" 2>/dev/null || model_top_p "$cur")"
  effort="$(normalize_effort "${LLM_EFFORT:-xhigh}" "$fam")" || return 1

  local brave_key="${BRAVE_API_KEY:-}"
  if [[ -z "$brave_key" && -r "$BRAVE_KEY_FILE" ]]; then
    brave_key="$(tr -d '[:space:]' <"$BRAVE_KEY_FILE")"
  fi
  local search_backend="${SEARCH_BACKEND:-}"
  if [[ -z "$search_backend" && -n "$brave_key" ]]; then search_backend=brave; fi

  BRAVE_API_KEY="$brave_key" \
  SEARCH_BACKEND="$search_backend" \
  MODEL="$upstream" \
  MODEL_FAMILY="$fam" \
  DEFAULT_TEMP="$temp" \
  DEFAULT_TOP_P="$top_p" \
  UPSTREAM="http://127.0.0.1:${LLAMA_PORT}/v1" \
  PORT="${PROXY_PORT}" \
  THINK_VIEW="${THINK_VIEW:-native}" \
  REASONING_EFFORT="$effort" \
    detach node "$PROXY_JS" >"$PROXY_LOG" 2>&1 &
  echo $! >"$PROXY_PID"
  sleep 1
  if is_running "$PROXY_PID"; then
    echo "  proxy    up on http://127.0.0.1:${PROXY_PORT}  (Anthropic API, model=${upstream}, family=${fam}, think=${effort})"
  else
    echo "  proxy failed to start — see $PROXY_LOG" >&2
    tail -10 "$PROXY_LOG" >&2
  fi
}

start_splash_backend() {
  local model="$1"
  local key ctx
  key="$(model_splash_key "$model")"
  ctx="$(model_ctx "$model")"
  if [[ ! -x "$LMS" ]]; then
    echo "LM Studio CLI not found (looked for lms on PATH and ${HOME}/.lmstudio/bin/lms)" >&2
    echo "install LM Studio, run ~/.lmstudio/bin/lms bootstrap, then: lms runtime get splash" >&2
    exit 1
  fi
  if ! "$LMS" ls 2>/dev/null | grep -qiF "$SPLASH_BASE_NAME"; then
    echo "model not downloaded: incoai/$SPLASH_BASE_NAME" >&2
    echo "download it first:  lms get https://huggingface.co/incoai/Qwen3.8-27B-Splash" >&2
    exit 1
  fi
  ensure_splash_virtual_model || exit 1
  echo "starting qwen3.8-${model} (LM Studio Splash, ctx ${ctx})"
  "$LMS" server start --port "$LLAMA_PORT" >"$SERVER_LOG" 2>&1 || {
    echo "  lms server start failed:" >&2; tail -20 "$SERVER_LOG" >&2; exit 1; }
  write_state_metadata "$model"
  "$LMS" load "$key" --identifier qwen-local --context-length "$ctx" \
    --gpu max -y >>"$SERVER_LOG" 2>&1 || {
    echo "  lms load failed:" >&2; tail -20 "$SERVER_LOG" >&2
    "$LMS" server stop >/dev/null 2>&1 || true; clear_state_metadata; exit 1; }
  lsof -nP -iTCP:"$LLAMA_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 >"$SERVER_PID"
  wait_healthy || { clear_state_metadata; exit 1; }
  echo "  LM Studio (Splash) up on http://127.0.0.1:${LLAMA_PORT}  (OpenAI API)"
}

start_omlx_backend() {
  local model="$1"
  local mdir fam ctx temp top_p omlx_cli
  omlx_cli="$(find_omlx_cli)" || {
    echo "oMLX CLI not found (install oMLX.app to /Applications/oMLX.app)" >&2
    exit 1
  }
  mdir="$(model_dir "$model")"
  if [[ ! -d "$mdir" ]]; then
    echo "model weights missing: $mdir" >&2
    exit 1
  fi
  fam="$(model_family "$model")"
  ctx="$(model_ctx "$model")"
  temp="$(model_temp "$model")"
  top_p="$(model_top_p "$model")"

  rm -rf "$OMLX_MODELS"
  mkdir -p "$OMLX_MODELS" "$OMLX_BASE" "$OMLX_CACHE"
  ln -sfn "$mdir" "${OMLX_MODELS}/${model}"

  cat >"${OMLX_BASE}/model_settings.json" <<EOF
{
  "version": 1,
  "models": {
    "${model}": {
      "mtp_enabled": true,
      "dflash_enabled": false,
      "turboquant_kv_enabled": false,
      "temperature": ${temp},
      "top_p": ${top_p},
      "force_sampling": false
    }
  }
}
EOF

  cat >"${OMLX_BASE}/settings.json" <<EOF
{
  "server": {
    "host": "127.0.0.1",
    "port": ${LLAMA_PORT}
  },
  "auth": {
    "skip_api_key_verification": true
  },
  "cache": {
    "paged_ssd_cache_dir": "${OMLX_CACHE}",
    "paged_ssd_cache_max_size": "40GB",
    "hot_cache_max_size": "2GB",
    "hot_cache_write_through": true
  }
}
EOF

  echo "starting ${fam}-${model} (oMLX v0.8.1, ctx ${ctx})"
  local tf32_flag=""
  if [[ "$fam" == "inkling2" ]]; then
    tf32_flag="0"
  fi

  if [[ -n "$tf32_flag" ]]; then
    MLX_ENABLE_TF32="$tf32_flag" detach "$omlx_cli" serve \
      --model-dir "$OMLX_MODELS" \
      --base-path "$OMLX_BASE" \
      --host 127.0.0.1 \
      --port "$LLAMA_PORT" \
      --no-hf-cache \
      --headless \
      --memory-guard-gb 46 \
      --paged-ssd-cache-dir "$OMLX_CACHE" \
      --paged-ssd-cache-max-size 40GB \
      --hot-cache-max-size 2GB \
      --hot-cache-write-through \
      --max-concurrent-requests 2 \
      --log-level info >"$SERVER_LOG" 2>&1 &
  else
    detach "$omlx_cli" serve \
      --model-dir "$OMLX_MODELS" \
      --base-path "$OMLX_BASE" \
      --host 127.0.0.1 \
      --port "$LLAMA_PORT" \
      --no-hf-cache \
      --headless \
      --memory-guard-gb 46 \
      --paged-ssd-cache-dir "$OMLX_CACHE" \
      --paged-ssd-cache-max-size 40GB \
      --hot-cache-max-size 2GB \
      --hot-cache-write-through \
      --max-concurrent-requests 2 \
      --log-level info >"$SERVER_LOG" 2>&1 &
  fi
  echo $! >"$SERVER_PID"
  write_state_metadata "$model"
  wait_healthy || { stop_pidfile "$SERVER_PID" "omlx"; clear_state_metadata; exit 1; }

  echo "  preloading ${model}..."
  if ! curl -sf --max-time 240 -X POST -H "Content-Type: application/json" -d '{}' \
      "http://127.0.0.1:${LLAMA_PORT}/v1/models/${model}/load" >/dev/null 2>&1; then
    echo "  warning: explicit preload returned non-zero (model will lazy-load on first request)" >&2
  fi
  echo "  oMLX up on http://127.0.0.1:${LLAMA_PORT}  (OpenAI API, model=${model})"
}

cmd_start() {
  reconcile
  local raw="${1:-$DEFAULT_MODEL}"
  local model eng fam
  if ! model="$(canonical_model "$raw")"; then
    echo "unknown model '$raw' (expected one of: ${MODEL_ALIASES})" >&2
    exit 1
  fi
  eng="$(model_engine "$model")"
  fam="$(model_family "$model")"
  # Validate LLM_EFFORT early before tearing down or starting a server
  normalize_effort "${LLM_EFFORT:-xhigh}" "$fam" >/dev/null || exit 1

  if is_running "$SERVER_PID"; then
    local cur; cur="$(cat "$CURRENT" 2>/dev/null || echo '?')"
    if [[ "$cur" == "$model" ]]; then
      echo "$model already serving on :${LLAMA_PORT}"
      start_proxy
      return 0
    fi
    echo "switching ${cur} -> ${model}"
    stop_pidfile "$PROXY_PID" "proxy"
    stop_server
    clear_state_metadata
  fi

  wait_port_free "$LLAMA_PORT" || exit 1

  case "$eng" in
    splash) start_splash_backend "$model" ;;
    omlx)   start_omlx_backend "$model" ;;
  esac
  start_proxy
}

cmd_stop() {
  reconcile
  echo "stopping local LLM stack"
  stop_pidfile "$PROXY_PID" "proxy"
  stop_server
  clear_state_metadata
  echo "  done"
}

cmd_status() {
  reconcile
  local model eng fam ctx
  model="$(cat "$CURRENT" 2>/dev/null || echo '-')"
  eng="$(cat "$ENGINE_FILE" 2>/dev/null || echo 'server')"
  fam="$(cat "$FAMILY_FILE" 2>/dev/null || echo '-')"
  ctx="$(cat "$CTX_FILE" 2>/dev/null || echo '-')"
  if is_running "$SERVER_PID"; then
    local rss
    rss="$(ps -o rss= -p "$(cat "$SERVER_PID")" 2>/dev/null | awk '{printf "%.1f GB", $1/1048576}')"
    printf "%-13s running   model=%s-%s  port=%s  ctx=%s  rss=%s\n" "$eng" "$fam" "$model" "$LLAMA_PORT" "$ctx" "${rss:-?}"
  else
    echo "model server  stopped"
  fi

  if is_running "$PROXY_PID"; then
    local hj eff p_fam
    hj="$(curl -sf --max-time 5 "http://127.0.0.1:${PROXY_PORT}/health" 2>/dev/null || echo '{}')"
    eff="$(printf '%s' "$hj" | sed -n 's/.*"effort":"\([^"]*\)".*/\1/p')"
    p_fam="$(printf '%s' "$hj" | sed -n 's/.*"family":"\([^"]*\)".*/\1/p')"
    echo "proxy         running   port=${PROXY_PORT}  family=${p_fam:-?}  think=${eff:-?}"
  else
    echo "proxy         stopped"
  fi

  if curl -sf --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
    echo "health        ok"
  else
    echo "health        busy or not responding (a long generation may be holding it)"
  fi
}

case "${1:-status}" in
  start)   shift; cmd_start "${1:-$DEFAULT_MODEL}" ;;
  stop)    cmd_stop ;;
  restart)
    shift
    _want="${1:-$(cat "$CURRENT" 2>/dev/null || echo "$DEFAULT_MODEL")}"
    cmd_stop; cmd_start "$_want" ;;
  restart-proxy)
    reconcile
    stop_pidfile "$PROXY_PID" "proxy"
    start_proxy ;;
  status)  cmd_status ;;
  which)   cat "$CURRENT" 2>/dev/null || echo "nothing loaded" ;;
  logs)
    case "${2:-server}" in
      proxy)  tail -f "$PROXY_LOG" ;;
      *)
        _eng="$(cat "$ENGINE_FILE" 2>/dev/null || echo "")"
        if [[ "$_eng" == "splash" ]]; then
          exec "$LMS" log stream
        else
          tail -f "$SERVER_LOG"
        fi
        ;;
    esac ;;
  *)
    grep '^#' "$0" | sed -n '2,14p' | sed -E 's/^# ?//'
    exit 1 ;;
esac

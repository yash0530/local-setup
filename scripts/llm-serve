#!/usr/bin/env bash
# llm-serve — start/stop the local Qwen 3.8 27B stack (model server + Anthropic proxy).
#
#   llm-serve start [splash4]
#     splash4 (the only model) is incoai/Qwen3.8-27B-Splash (4-bit + DFlash2) on LM
#     Studio's Splash engine.
#   llm-serve stop              stop everything
#   llm-serve status            what's running, and whether it answers
#   llm-serve restart [model]   stop then start
#   llm-serve restart-proxy     reload just the proxy (keeps the model resident)
#   llm-serve logs [server|proxy]  tail a log
#   llm-serve which             the currently-loaded model

set -euo pipefail

STATE_DIR="${HOME}/.local/state/local-llm"
LOG_DIR="${STATE_DIR}/logs"
mkdir -p "$LOG_DIR"

SERVER_PID="${STATE_DIR}/server.pid"
PROXY_PID="${STATE_DIR}/proxy.pid"
CURRENT="${STATE_DIR}/current"
SERVER_LOG="${LOG_DIR}/server.log"
PROXY_LOG="${LOG_DIR}/proxy.log"
BRAVE_KEY_FILE="${HOME}/.config/local-llm/brave_api_key"

LLAMA_PORT="${LLAMA_PORT:-8089}"
PROXY_PORT="${PROXY_PORT:-8790}"
CTX="${LLM_SPLASH_CTX:-${LLM_CTX:-262144}}"

# Reasoning effort, forwarded by the proxy on every request. Qwen 3.8's template has
# exactly three levels; anything else is a template error, so spellings are normalised.
normalize_effort() { # effort -> low|medium|xhigh, or fail
  case "$(echo "${1:-}" | tr 'A-Z' 'a-z')" in
    xhigh|high|max|x-high|extra-high) echo xhigh ;;
    medium|med|default)                echo medium ;;
    low|minimal|min)                   echo low ;;
    *) echo "invalid reasoning effort '${1:-}' (expected low, medium or xhigh)" >&2; return 1 ;;
  esac
}
LLM_EFFORT="$(normalize_effort "${LLM_EFFORT:-xhigh}")" || exit 1

# Resolve the real script location: it is run via a symlink in ~/.local/bin, and repo
# files (dotfiles/lmstudio) are found relative to the repo, not the symlink.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link="$(readlink "$_self")"
  [[ "$_link" == /* ]] && _self="$_link" || _self="$(dirname "$_self")/$_link"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
PROXY_JS="${SCRIPT_DIR}/llm-proxy.mjs"

# --- model registry ------------------------------------------------------------
MODEL_ALIASES="splash4"
DEFAULT_MODEL="splash4"

# An LM Studio model key, not a file: the virtual model from dotfiles/lmstudio/, which
# exposes reasoning_effort (the bare download makes LM Studio drop that field).
model_key() {
  case "$1" in
    splash4) echo "local/qwen3.8-27b-splash" ;;
    *) return 1 ;;
  esac
}

# `lms bootstrap` puts lms on PATH, but a fresh install only has ~/.lmstudio/bin.
LMS="${LLM_LMS:-$(command -v lms 2>/dev/null || echo "${HOME}/.lmstudio/bin/lms")}"
# The downloaded weights the virtual model wraps, as `lms ls` names them.
SPLASH_BASE_NAME="Qwen3.8-27B-Splash"
# A hub model is a manifest.json (base-weights dependency) plus model.yaml (the override).
SPLASH_VIRTUAL_SRC="$(cd "$SCRIPT_DIR/.." && pwd)/dotfiles/lmstudio/qwen3.8-27b-splash"
SPLASH_VIRTUAL_DST="${HOME}/.lmstudio/hub/models/local/qwen3.8-27b-splash"

# Keep LM Studio's copy of the virtual model in step with the repo (picked up on next load).
# LM Studio re-indexes on change; a rejected model.yaml shows up as a ZodError in
# ~/Library/Logs/LM Studio.
ensure_splash_virtual_model() {
  local f changed=0
  mkdir -p "$SPLASH_VIRTUAL_DST"
  for f in manifest.json model.yaml; do
    [[ -f "$SPLASH_VIRTUAL_SRC/$f" ]] || { echo "missing $SPLASH_VIRTUAL_SRC/$f" >&2; return 1; }
    if ! cmp -s "$SPLASH_VIRTUAL_SRC/$f" "$SPLASH_VIRTUAL_DST/$f"; then
      cp "$SPLASH_VIRTUAL_SRC/$f" "$SPLASH_VIRTUAL_DST/$f"; changed=1
    fi
  done
  if [[ $changed == 1 ]]; then
    echo "  installed LM Studio virtual model local/qwen3.8-27b-splash"
    sleep 3  # give the indexer a moment before `lms load` looks the key up
  fi
}

model_family() { echo "qwen3.8"; }

is_running() { # pidfile
  [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null
}

# An interrupted `start` can leave a live daemon with no pidfile; trust the listening
# socket over the file.
adopt_orphan() { # port pidfile
  local pid
  pid="$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1)"
  [[ -n "$pid" ]] || return 1
  echo "  adopting orphaned process on :$1 (pid $pid)" >&2
  echo "$pid" >"$2"
}

# Recover `current` from the running server's argv so `status` and `which` don't lie.
reconcile() {
  is_running "$SERVER_PID" || adopt_orphan "$LLAMA_PORT" "$SERVER_PID" || true
  is_running "$PROXY_PID" || adopt_orphan "$PROXY_PORT" "$PROXY_PID" || true

  if [[ ! -s "$CURRENT" ]] && is_running "$SERVER_PID"; then
    local argv
    argv="$(ps -o command= -p "$(cat "$SERVER_PID")" 2>/dev/null)"
    case "$argv" in *"LM Studio"*|*lmstudio*|*llmster*) echo "splash4" >"$CURRENT" ;; esac
  fi
}

# Run a daemon in its own session. nohup alone leaves it in the caller's process group,
# so Ctrl-C or a closing terminal kills it. macOS has no setsid(1), so use perl.
# Always call as `detach cmd ... &`: the exec keeps $! as the daemon's own pid.
detach() { # cmd args...
  exec perl -e 'use POSIX (); POSIX::setsid(); exec @ARGV or die "exec failed: $!"' -- "$@"
}

stop_pidfile() { # pidfile label
  if is_running "$1"; then
    local pid; pid="$(cat "$1")"
    echo "  stopping $2 (pid $pid)"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    # SIGKILL is async: the listening socket is only released once the process reaps.
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
      done
    fi
  fi
  rm -f "$1"
}

# True while any TCP socket holds the port, including TIME_WAIT sockets `lsof` can't see.
port_in_use() { # port
  netstat -an -p tcp 2>/dev/null | awk -v suffix=".$1" '
    NR > 2 && length($4) > length(suffix) &&
    substr($4, length($4) - length(suffix) + 1) == suffix { found = 1 }
    END { exit !found }'
}

# A lingering TIME_WAIT socket on the server port can make the next bind fail.
# Wait it out rather than race it.
wait_port_free() { # port
  port_in_use "$1" || return 0
  echo "  waiting for port $1 to clear"
  for _ in $(seq 1 60); do
    sleep 0.5
    port_in_use "$1" || return 0
  done
  echo "  port $1 still held after 30s:" >&2
  netstat -an -p tcp 2>/dev/null | awk -v suffix=".$1" '
    NR > 2 && length($4) > length(suffix) &&
    substr($4, length($4) - length(suffix) + 1) == suffix' >&2
  return 1
}

# LM Studio has no /health, only the OpenAI routes.
HEALTH_URL="http://127.0.0.1:${LLAMA_PORT}/v1/models"

# Splash lives inside LM Studio, so killing the pid on the port would take the app down.
stop_server() {
  is_running "$SERVER_PID" || [[ -s "$CURRENT" ]] || return 0
  echo "  unloading LM Studio model and stopping its server"
  "$LMS" unload --all >/dev/null 2>&1 || true
  "$LMS" server stop >/dev/null 2>&1 || true
  rm -f "$SERVER_PID"
}

wait_healthy() {
  for _ in $(seq 1 300); do
    if curl -sf --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then return 0; fi
    if ! is_running "$SERVER_PID"; then
      echo "  model server died on startup — last lines:" >&2
      tail -20 "$SERVER_LOG" >&2
      return 1
    fi
    sleep 1
  done
  echo "  timed out waiting for the model server to become healthy" >&2
  return 1
}

start_proxy() {
  if is_running "$PROXY_PID"; then return 0; fi
  # WebSearch uses Brave when a key is on file. The key lives outside this repo, and
  # an exported BRAVE_API_KEY or SEARCH_BACKEND still wins.
  local brave_key="${BRAVE_API_KEY:-}"
  if [[ -z "$brave_key" && -r "$BRAVE_KEY_FILE" ]]; then
    brave_key="$(tr -d '[:space:]' <"$BRAVE_KEY_FILE")"
  fi
  local search_backend="${SEARCH_BACKEND:-}"
  if [[ -z "$search_backend" && -n "$brave_key" ]]; then search_backend=brave; fi
  # LM Studio serves the model as `qwen-local`. THINK_VIEW=native renders reasoning in
  # Claude Code's own thinking UI; off|status|text are the alternatives.
  BRAVE_API_KEY="$brave_key" \
  SEARCH_BACKEND="$search_backend" \
  MODEL="qwen-local" \
  UPSTREAM="http://127.0.0.1:${LLAMA_PORT}/v1" \
  PORT="${PROXY_PORT}" \
  THINK_VIEW="${THINK_VIEW:-native}" \
  REASONING_EFFORT="${LLM_EFFORT:-}" \
    detach node "$PROXY_JS" >"$PROXY_LOG" 2>&1 &
  echo $! >"$PROXY_PID"
  sleep 1
  if is_running "$PROXY_PID"; then
    echo "  proxy    up on http://127.0.0.1:${PROXY_PORT}  (Anthropic API)"
  else
    echo "  proxy failed to start — see $PROXY_LOG" >&2
    tail -10 "$PROXY_LOG" >&2
  fi
}

cmd_start() {
  reconcile
  local model="${1:-$DEFAULT_MODEL}"
  local key
  if ! key="$(model_key "$model")"; then
    echo "unknown model '$model' (expected one of: ${MODEL_ALIASES})" >&2
    exit 1
  fi
  if [[ ! -x "$LMS" ]]; then
    echo "LM Studio CLI not found (looked for lms on PATH and ${HOME}/.lmstudio/bin/lms)" >&2
    echo "install LM Studio, run ~/.lmstudio/bin/lms bootstrap, then: lms runtime get splash" >&2
    exit 1
  fi
  if ! "$LMS" ls 2>/dev/null | grep -qiF "$SPLASH_BASE_NAME"; then
    echo "model not downloaded: incoai/$SPLASH_BASE_NAME" >&2
    echo "download it first:  lms get https://huggingface.co/incoai/Qwen3.8-27B-Splash" >&2
    exit 1
  fi

  if is_running "$SERVER_PID"; then
    local cur; cur="$(cat "$CURRENT" 2>/dev/null || echo '?')"
    if [[ "$cur" == "$model" ]]; then
      echo "$model already serving on :${LLAMA_PORT}"
      start_proxy
      return 0
    fi
    echo "switching ${cur} -> ${model}"
    # Stop the proxy first: whichever side closes a keep-alive connection lands in
    # TIME_WAIT, and it must not be the server's port.
    stop_pidfile "$PROXY_PID" "proxy"
    stop_server
  fi

  wait_port_free "$LLAMA_PORT" || exit 1

  # LM Studio owns the drafter and mlock; sampling and reasoning_effort come per-request.
  ensure_splash_virtual_model || exit 1
  echo "starting $(model_family "$model")-${model} (LM Studio Splash, ctx ${CTX})"
  "$LMS" server start --port "$LLAMA_PORT" >"$SERVER_LOG" 2>&1 || {
    echo "  lms server start failed:" >&2; tail -20 "$SERVER_LOG" >&2; exit 1; }
  echo "$model" >"$CURRENT"
  "$LMS" load "$key" --identifier qwen-local --context-length "$CTX" \
    --gpu max -y >>"$SERVER_LOG" 2>&1 || {
    echo "  lms load failed:" >&2; tail -20 "$SERVER_LOG" >&2
    "$LMS" server stop >/dev/null 2>&1 || true; rm -f "$CURRENT"; exit 1; }
  # Record the listener so is_running/status can track it.
  lsof -nP -iTCP:"$LLAMA_PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 >"$SERVER_PID"
  wait_healthy || exit 1
  echo "  LM Studio (Splash) up on http://127.0.0.1:${LLAMA_PORT}  (OpenAI API)"
  start_proxy
}

cmd_stop() {
  reconcile
  echo "stopping local LLM stack"
  stop_pidfile "$PROXY_PID" "proxy"
  stop_server
  rm -f "$CURRENT"
  echo "  done"
}

cmd_status() {
  reconcile
  local model; model="$(cat "$CURRENT" 2>/dev/null || echo '-')"
  if is_running "$SERVER_PID"; then
    local rss
    rss="$(ps -o rss= -p "$(cat "$SERVER_PID")" | awk '{printf "%.1f GB", $1/1048576}')"
    echo "lmstudio      running   model=$(model_family "$model")-${model}  port=${LLAMA_PORT}  rss=${rss}"
  else
    echo "lmstudio      stopped"
  fi

  if is_running "$PROXY_PID"; then
    local eff
    eff="$(curl -sf --max-time 5 "http://127.0.0.1:${PROXY_PORT}/health" 2>/dev/null \
      | sed -n 's/.*"effort":"\([a-z]*\)".*/\1/p')"
    echo "proxy         running   port=${PROXY_PORT}  think=${eff:-?}"
  else
    echo "proxy         stopped"
  fi

  # --max-time: a long generation can hold the server and would hang `status`.
  if curl -sf --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
    echo "health        ok"
  else
    echo "health        busy or not responding (a long generation may be holding it)"
  fi
}

case "${1:-status}" in
  start)   shift; cmd_start "${1:-$DEFAULT_MODEL}" ;;
  stop)    cmd_stop ;;
  # Read $CURRENT before cmd_stop deletes it, so a bare restart keeps the resident model.
  restart)
    shift
    _want="${1:-$(cat "$CURRENT" 2>/dev/null || echo "$DEFAULT_MODEL")}"
    cmd_stop; cmd_start "$_want" ;;
  restart-proxy)
    stop_pidfile "$PROXY_PID" "proxy"
    start_proxy ;;
  status)  cmd_status ;;
  which)   cat "$CURRENT" 2>/dev/null || echo "nothing loaded" ;;
  logs)
    case "${2:-server}" in
      proxy)  tail -f "$PROXY_LOG" ;;
      # LM Studio keeps its own log; ours only has the start/load output.
      *)       exec "$LMS" log stream ;;
    esac ;;
  *)
    grep '^#' "$0" | sed -n '2,12p' | sed -E 's/^# ?//'
    exit 1 ;;
esac

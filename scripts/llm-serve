#!/usr/bin/env bash
# llm-serve — start/stop/switch the local Qwen stack (llama-server + Anthropic proxy).
#
# Serving flags come from the local_llm_bench sweep: the draft depth for each
# model is the measured peak, not a guess.
#
#   llm-serve start [35b|27b|mlx8|mlx6|mlx4]  start (or switch to) a model + proxy
#     35b/27b are GGUF via llama-server; mlx8/mlx6/mlx4 are MLX via mlx_vlm.server
#   llm-serve stop              stop everything
#   llm-serve status            what's running, and whether it answers
#   llm-serve restart [model]   stop then start
#   llm-serve restart-proxy     reload just the proxy (keeps the model resident)
#   llm-serve logs [server|proxy]  tail a log
#   llm-serve which             the currently-loaded model

set -euo pipefail

STATE_DIR="${HOME}/.local/state/local-llm"
LOG_DIR="${STATE_DIR}/logs"
# KV slot cache. Cold prefill runs ~214 tok/s on the 35B A3B, so a 141K resume
# costs ~11 min on a cache miss. --slot-save-path only enables the
# /slots/{id}?action=save|restore endpoints; llama.cpp does not persist or
# reload slots on its own, so nothing uses this until something calls them.
# --cache-reuse is the one that helps automatically.
KV_DIR="${STATE_DIR}/kv"
mkdir -p "$LOG_DIR" "$KV_DIR"

SERVER_PID="${STATE_DIR}/server.pid"
PROXY_PID="${STATE_DIR}/proxy.pid"
CURRENT="${STATE_DIR}/current"
SERVER_LOG="${LOG_DIR}/server.log"
PROXY_LOG="${LOG_DIR}/proxy.log"

LLAMA_PORT="${LLAMA_PORT:-8089}"
PROXY_PORT="${PROXY_PORT:-8790}"
CTX="${LLM_CTX:-262144}"

# Thinking is unlimited by default — these are reasoning models and the quality
# comes from letting them finish. The proxy's SSE heartbeat is what keeps a long
# reasoning phase from looking like a dead connection, so no cap is needed here.
# Set LLM_THINK_BUDGET to a token count if you ever want to bound latency.
THINK_BUDGET="${LLM_THINK_BUDGET:--1}"

# The proxy lives next to this script.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_JS="${SCRIPT_DIR}/llm-proxy.mjs"

# --- model registry (Q8 GGUFs, MTP draft depth = benchmarked peak) ------------
# Single list of valid aliases, used for validation, error messages, and recovering
# which model a running server is serving.
MODEL_ALIASES="35b 27b mlx8 mlx6 mlx4"

model_path() {
  case "$1" in
    35b) echo "${HOME}/Models/qwen3.6-35b-a3b-mtp-q8/Qwen3.6-35B-A3B-Q8_0.gguf" ;;
    27b) echo "${HOME}/Models/qwen3.8-27b-gguf/Qwen3.8-27B-Q8_0.gguf" ;;
    mlx8) echo "${HOME}/Models/qwen3.8-27b-mlx-8bit" ;;
    mlx6) echo "${HOME}/Models/qwen3.8-27b-mlx-6bit" ;;
    mlx4) echo "${HOME}/Models/qwen3.8-27b-mlx-4bit" ;;
    *) return 1 ;;
  esac
}

# Which engine serves an alias. MLX beat llama.cpp at every matched size in the 3.8
# sweep — by 10% at 8-bit and 54-59% at 6- and 4-bit — so these are served by
# mlx_vlm.server rather than llama-server. The two paths share nothing but the port and
# the `qwen-local` model name the proxy expects.
model_engine() {
  case "$1" in
    mlx8|mlx6|mlx4) echo "mlx" ;;
    *) echo "llamacpp" ;;
  esac
}

# MLX speculation is a separate drafter checkpoint rather than a head inside the weights.
# It is held at 8-bit no matter how the target is quantized, which is precisely why MLX
# keeps ~49% acceptance at every size while llama.cpp's inline head decays with the model.
model_draft() {
  case "$1" in
    mlx8|mlx6|mlx4) echo "${HOME}/Models/qwen3.8-27b-mtp-mlx-8bit" ;;
    *) echo "" ;;
  esac
}

# Python that has mlx_vlm installed. Defaults to the benchmark repo's venv; override with
# LLM_MLX_PY if that repo moves.
MLX_PY="${LLM_MLX_PY:-${HOME}/Desktop/Programming/local_llm_bench/.mlxenv/bin/python}"

# Display name for a model alias. The family is no longer implied by the script: the two
# aliases are now different Qwen generations, so a hardcoded prefix would mislabel one.
model_family() {
  case "$1" in
    35b) echo "qwen3.6" ;;
    27b|mlx8|mlx6|mlx4) echo "qwen3.8" ;;
    *) echo "qwen" ;;
  esac
}

# Qwen 3.8 asks for temp 1.0 in thinking mode; 3.6 asks for 0.6. Serving both at one
# value would mean serving one of them against its own recommendation.
model_temp() {
  case "$1" in
    27b|mlx8|mlx6|mlx4) echo 1.0 ;;
    *) echo 0.6 ;;
  esac
}

# Peak-throughput draft depth per model, measured over the sweep:
#   35B A3B: n=1 -> 67.2 tok/s (78% accept)   27B: n=3 -> 19.8 tok/s (68% accept)
# The `*)` default matters: without it an unknown alias yields an empty string and the
# launch line becomes `--spec-draft-n-max ` with no value.
draft_n() {
  case "$1" in
    35b) echo 1 ;;
    27b) echo 3 ;;
    # MLX draft_block_size, not a llama.cpp draft-n: the drafter proposes block_size - 1
    # tokens, so 3 is the checkpoint's configured block and what the sweep measured.
    mlx8|mlx6|mlx4) echo 3 ;;
    *) echo 2 ;;
  esac
}

is_running() { # pidfile
  [[ -f "$1" ]] && kill -0 "$(cat "$1")" 2>/dev/null
}

# The pidfiles are a record, not the truth. An interrupted `start` — Ctrl-C
# while the model loads, say — can leave a live daemon with no pidfile, after
# which llm-serve reports "stopped", then tries to start a second one and hangs
# on a port that is very much in use. Trust the listening socket over the file.
adopt_orphan() { # port pidfile
  local pid
  pid="$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | head -1)"
  [[ -n "$pid" ]] || return 1
  echo "  adopting orphaned process on :$1 (pid $pid)" >&2
  echo "$pid" >"$2"
}

# Recover `current` from the running server's argv, since the model name is
# right there in -m and losing it only makes `status` and `which` lie.
reconcile() {
  is_running "$SERVER_PID" || adopt_orphan "$LLAMA_PORT" "$SERVER_PID" || true
  is_running "$PROXY_PID" || adopt_orphan "$PROXY_PORT" "$PROXY_PID" || true

  if [[ ! -s "$CURRENT" ]] && is_running "$SERVER_PID"; then
    # Match the running argv against the registry rather than parsing a model name out
    # of the path. Two generations can share a size — qwen3.6-27b and qwen3.8-27b both
    # contain "27b" — so a pattern match would recover an alias that serves the wrong
    # model, while comparing against model_path() cannot.
    local argv found=""
    argv="$(ps -o command= -p "$(cat "$SERVER_PID")" 2>/dev/null)"
    if [[ -n "$argv" ]]; then
      local alias_ path_
      for alias_ in $MODEL_ALIASES; do
        path_="$(model_path "$alias_")" || continue
        if [[ "$argv" == *"$path_"* ]]; then found="$alias_"; break; fi
      done
    fi
    [[ -n "$found" ]] && echo "$found" >"$CURRENT"
  fi
}

# Run a daemon in its own session, detached from the caller's process group.
#
# `nohup ... &` alone is not enough: nohup only ignores SIGHUP, while the child
# stays in the invoking shell's process group. Anything that signals that group
# — Ctrl-C, a closing terminal, a script killed on timeout — takes the daemon
# with it. That is exactly how the proxy has died: orphaned into a dead group.
#
# macOS ships no setsid(1), so borrow it from perl, which is always present.
# exec keeps the pid, so $! is still the daemon's own pid. setsid() failing
# because we are already a group leader is fine — that means we are already
# isolated, which is the whole point.
#
# Always call as `detach cmd ... &`. The trailing & forks a subshell, and the
# exec below replaces *that* subshell — so $! is the daemon's own pid rather
# than a bash wrapper that merely waits on it. Without the exec, the pidfile
# records the wrapper, stop_pidfile kills the wrapper, and the real daemon is
# orphaned still holding its port.
detach() { # cmd args...
  exec perl -e 'use POSIX (); POSIX::setsid(); exec @ARGV or die "exec failed: $!"' -- "$@"
}

stop_pidfile() { # pidfile label
  if is_running "$1"; then
    local pid; pid="$(cat "$1")"
    echo "  stopping $2 (pid $pid)"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
    # SIGKILL is asynchronous: tearing down ~35 GB of Metal buffers takes the
    # kernel a moment, and the fds (including the listening socket) are only
    # released when the process actually reaps. Wait for that, don't assume it.
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
      for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.2
      done
    fi
  fi
  rm -f "$1"
}

# True while any TCP socket still holds the port — including orphaned TIME_WAIT
# sockets, which belong to no process and so never show up in `lsof`.
port_in_use() { # port
  netstat -an -p tcp 2>/dev/null | awk -v suffix=".$1" '
    NR > 2 && length($4) > length(suffix) &&
    substr($4, length($4) - length(suffix) + 1) == suffix { found = 1 }
    END { exit !found }'
}

# httplib (what llama-server binds with) sets SO_REUSEPORT on macOS, not
# SO_REUSEADDR — so unlike most servers it cannot bind over a lingering
# TIME_WAIT socket, and a switch fails with "couldn't bind HTTP server socket".
# Stopping the proxy first (below) normally keeps :8089 clean, but a client that
# died mid-request can still leave one behind. Wait it out rather than race it.
wait_port_free() { # port
  port_in_use "$1" || return 0
  echo "  waiting for port $1 to clear"
  for _ in $(seq 1 60); do
    sleep 0.5
    port_in_use "$1" || return 0
  done
  echo "  port $1 still held after 30s:" >&2
  netstat -an -p tcp 2>/dev/null | awk -v suffix=".$1" '
    NR > 2 && length($4) > length(suffix) &&
    substr($4, length($4) - length(suffix) + 1) == suffix' >&2
  return 1
}

wait_healthy() {
  for _ in $(seq 1 300); do
    if curl -sf --max-time 5 "http://127.0.0.1:${LLAMA_PORT}/health" >/dev/null 2>&1; then return 0; fi
    if ! is_running "$SERVER_PID"; then
      echo "  llama-server died on startup — last lines:" >&2
      tail -20 "$SERVER_LOG" >&2
      return 1
    fi
    sleep 1
  done
  echo "  timed out waiting for llama-server to become healthy" >&2
  return 1
}

start_proxy() {
  if is_running "$PROXY_PID"; then return 0; fi
  # The model reasons on every turn regardless; `native` means Claude Code
  # renders that phase in its own thinking UI instead of the stream just going
  # quiet for a minute. Verified: the harness parses the blocks and keeps the
  # signature. THINK_VIEW=off|status|text to change it — see the proxy header.
  MODEL=qwen-local \
  UPSTREAM="http://127.0.0.1:${LLAMA_PORT}/v1" \
  PORT="${PROXY_PORT}" \
  THINK_VIEW="${THINK_VIEW:-native}" \
    detach node "$PROXY_JS" >"$PROXY_LOG" 2>&1 &
  echo $! >"$PROXY_PID"
  sleep 1
  if is_running "$PROXY_PID"; then
    echo "  proxy    up on http://127.0.0.1:${PROXY_PORT}  (Anthropic API)"
  else
    echo "  proxy failed to start — see $PROXY_LOG" >&2
    tail -10 "$PROXY_LOG" >&2
  fi
}

cmd_start() {
  reconcile
  local model="${1:-35b}"
  local path
  if ! path="$(model_path "$model")"; then
    echo "unknown model '$model' (expected one of: ${MODEL_ALIASES})" >&2
    exit 1
  fi
  # GGUF models are a single file; MLX models are a directory of shards.
  if [[ ! -f "$path" && ! -d "$path" ]]; then
    echo "model not found: $path" >&2
    echo "download it first — see local-setup/README.md section 5.2" >&2
    exit 1
  fi
  if [[ "$(model_engine "$model")" == "mlx" && ! -x "$MLX_PY" ]]; then
    echo "no mlx_vlm interpreter at $MLX_PY" >&2
    echo "set LLM_MLX_PY to a python that has mlx_vlm installed" >&2
    exit 1
  fi

  # Only one model fits in 64 GB at Q8, so switching means replacing.
  if is_running "$SERVER_PID"; then
    local cur; cur="$(cat "$CURRENT" 2>/dev/null || echo '?')"
    if [[ "$cur" == "$model" ]]; then
      echo "$model already serving on :${LLAMA_PORT}"
      start_proxy
      return 0
    fi
    echo "switching ${cur} -> ${model}"
    # Order matters. The proxy holds keep-alive connections to llama-server, and
    # whichever side closes first is the side that lands in TIME_WAIT. Killing
    # the server first strands those sockets on :${LLAMA_PORT} and the
    # replacement cannot bind; closing the proxy first puts them on the proxy's
    # ephemeral ports instead, leaving :${LLAMA_PORT} free. It gets restarted at
    # the end of this function.
    stop_pidfile "$PROXY_PID" "proxy"
    stop_pidfile "$SERVER_PID" "llama-server"
  fi

  wait_port_free "$LLAMA_PORT" || exit 1

  # LLM_SPEC=0 serves without speculative decoding — useful for benchmarking, or
  # if a draft head ever misbehaves. Measured: it does NOT change the first-turn
  # prefill cost, which is bounded by prompt processing, not generation.
  # A 27-38 GB model on a 64 GB machine leaves little headroom, and macOS will
  # happily compress/evict model pages when Spotlight, contactsd and friends get
  # busy. Generation barely notices, but prefill sweeps every weight in large
  # batches, so it collapses — measured here from 196 tok/s to 4 tok/s on an
  # otherwise idle server. mlock pins the weights so that cannot happen.
  # LLM_MLOCK=0 to opt out.
  local mlock=(--mlock)
  [[ "${LLM_MLOCK:-1}" == "0" ]] && mlock=()

  local spec=(--spec-type draft-mtp --spec-draft-n-max "$(draft_n "$model")")
  local spec_label="MTP draft-n=$(draft_n "$model")"
  if [[ "${LLM_SPEC:-1}" == "0" ]]; then
    spec=()
    spec_label="MTP off"
  fi

  if [[ "$(model_engine "$model")" == "mlx" ]]; then
    local mlx_spec=()
    local draft; draft="$(model_draft "$model")"
    local mlx_label="MTP off"
    if [[ -d "$draft" && "${LLM_SPEC:-1}" != "0" ]]; then
      mlx_spec=(--draft-model "$draft" --draft-kind mtp
                --draft-block-size "$(draft_n "$model")")
      mlx_label="MTP block=$(draft_n "$model")"
    fi
    echo "starting $(model_family "$model")-${model} (MLX, ${mlx_label}, think budget ${THINK_BUDGET})"
    # APC_ENABLED defaults to "0" inside mlx_vlm, so prompt caching is off unless this is
    # set — a detail that silently invalidated a whole warm-cache measurement on 3.6.
    # KV stays unquantized: quantized KV plus MTP crashes this architecture at depth.
    APC_ENABLED=1 detach "$MLX_PY" -m mlx_vlm.server \
      --model "$path" \
      ${mlx_spec[@]+"${mlx_spec[@]}"} \
      --thinking-budget "$THINK_BUDGET" \
      --host 127.0.0.1 --port "${LLAMA_PORT}" \
      >"$SERVER_LOG" 2>&1 &
    echo $! >"$SERVER_PID"
    echo "$model" >"$CURRENT"
    wait_healthy || exit 1
    echo "  mlx_vlm.server up on http://127.0.0.1:${LLAMA_PORT}  (OpenAI API)"
    start_proxy
    return
  fi

  echo "starting $(model_family "$model")-${model} (Q8, ${spec_label}, ctx ${CTX}, think budget ${THINK_BUDGET})"
  # ${a[@]+"${a[@]}"}, not "${a[@]}": macOS ships bash 3.2, where expanding an
  # empty array under `set -u` is an unbound-variable error.
  detach llama-server \
    -m "$path" \
    ${spec[@]+"${spec[@]}"} \
    -c "$CTX" -ngl 99 -fa on -np 1 \
    ${mlock[@]+"${mlock[@]}"} \
    --cache-reuse 256 \
    --slot-save-path "$KV_DIR" \
    --jinja --reasoning-format deepseek \
    --reasoning-budget "$THINK_BUDGET" \
    --temp "$(model_temp "$model")" --top-p 0.95 --top-k 20 \
    -a qwen-local \
    --host 127.0.0.1 --port "${LLAMA_PORT}" --no-webui \
    >"$SERVER_LOG" 2>&1 &
  echo $! >"$SERVER_PID"
  echo "$model" >"$CURRENT"

  wait_healthy || exit 1
  echo "  llama-server up on http://127.0.0.1:${LLAMA_PORT}  (OpenAI API)"
  start_proxy
}

cmd_stop() {
  reconcile
  echo "stopping local LLM stack"
  stop_pidfile "$PROXY_PID" "proxy"
  stop_pidfile "$SERVER_PID" "llama-server"
  rm -f "$CURRENT"
  echo "  done"
}

cmd_status() {
  reconcile
  local model; model="$(cat "$CURRENT" 2>/dev/null || echo '-')"
  if is_running "$SERVER_PID"; then
    local rss
    rss="$(ps -o rss= -p "$(cat "$SERVER_PID")" | awk '{printf "%.1f GB", $1/1048576}')"
    echo "llama-server  running   model=$(model_family "$model")-${model}  port=${LLAMA_PORT}  rss=${rss}"
  else
    echo "llama-server  stopped"
  fi

  if is_running "$PROXY_PID"; then
    echo "proxy         running   port=${PROXY_PORT}"
  else
    echo "proxy         stopped"
  fi

  # --max-time matters: with -np 1 a long generation occupies the only slot, and
  # an un-timed curl would hang `status` itself instead of reporting the state.
  if curl -sf --max-time 5 "http://127.0.0.1:${LLAMA_PORT}/health" >/dev/null 2>&1; then
    echo "health        ok"
  else
    echo "health        busy or not responding (a long generation may hold the slot)"
  fi
}

case "${1:-status}" in
  start)   shift; cmd_start "${1:-35b}" ;;
  stop)    cmd_stop ;;
  restart) shift; cmd_stop; cmd_start "${1:-35b}" ;;
  # Picking up a proxy edit shouldn't cost a 37 GB model reload.
  restart-proxy)
    stop_pidfile "$PROXY_PID" "proxy"
    start_proxy ;;
  status)  cmd_status ;;
  which)   cat "$CURRENT" 2>/dev/null || echo "nothing loaded" ;;
  logs)
    case "${2:-server}" in
      proxy)  tail -f "$PROXY_LOG" ;;
      *)      tail -f "$SERVER_LOG" ;;
    esac ;;
  *)
    grep '^#' "$0" | sed -n '2,20p' | sed 's/^# \?//'
    exit 1 ;;
esac

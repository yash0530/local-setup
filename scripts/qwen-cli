#!/usr/bin/env bash
# qwen-cli [splash4]
#
# Interactive terminal chat on the local Qwen 3.8 27B: brings the model up in LM Studio
# (via llm-serve) and opens `lms chat`. Reasoning effort follows the model default here.
# Ctrl-C to quit.
set -euo pipefail

while [[ $# -gt 0 ]]; do
  case "$1" in
    splash4) shift ;;
    -h|--help) echo "usage: qwen-cli [splash4]"; exit 0 ;;
    *) echo "qwen-cli: unknown arg '$1'" >&2; exit 1 ;;
  esac
done

LMS="$(command -v lms 2>/dev/null || echo "${HOME}/.lmstudio/bin/lms")"
llm-serve start splash4
echo "qwen-cli: splash4 via lms chat — Ctrl-C to quit"
exec "$LMS" chat qwen-local

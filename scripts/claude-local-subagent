#!/usr/bin/env bash
# claude-local-subagent — Claude Code on your Pro subscription, with the local
# Qwen delegation subagent available for this session only (`claude subagent`).
#
# The local-llm plugin is deliberately NOT installed into ~/.claude, so a plain
# `claude` has no local subagent or skill; this loads it via --plugin-dir.
# Unlike `claude local ...`, the driver here is your normal Claude model.
#
#   claude subagent                          interactive
#   claude subagent -p "ask qwen to summarise src/parser.ts"
#
# Every argument is passed through to `claude` untouched.

set -euo pipefail

PLUGIN_DIR="${LOCAL_LLM_PLUGIN_DIR:-$HOME/.claude/local-plugins/local-llm}"

if [[ ! -f "$PLUGIN_DIR/.claude-plugin/plugin.json" ]]; then
  echo "local-llm plugin not found at $PLUGIN_DIR" >&2
  echo "run ./setup.sh from the local-setup repo to install it" >&2
  exit 1
fi

# LM Studio has no /health, only the OpenAI routes.
if ! curl -sf --max-time 3 "http://127.0.0.1:${LLAMA_PORT:-8089}/v1/models" >/dev/null 2>&1; then
  echo "note: the local model server isn't responding — run 'llm-serve start' before delegating." >&2
fi

exec claude --plugin-dir "$PLUGIN_DIR" "$@"
